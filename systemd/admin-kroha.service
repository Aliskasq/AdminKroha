[Unit]
Description=AdminKroha Telegram Bot for Binance Square
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/AdminKroha

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/AdminKroha/src
Environment=LOG_LEVEL=INFO
Environment=VIRTUAL_ENV=/root/AdminKroha/venv_production
Environment=PATH=/root/AdminKroha/venv_production/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/root/AdminKroha/venv_production/bin/python /root/AdminKroha/main.py

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

LimitNOFILE=65536
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=admin-kroha

[Install]
WantedBy=multi-user.target