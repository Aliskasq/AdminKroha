[Unit]
Description=AdminKroha Telegram Bot for Binance Square
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/AdminKroha

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/AdminKroha/src
Environment=LOG_LEVEL=INFO
Environment=VIRTUAL_ENV=/root/AdminKroha/venv
Environment=PATH=/root/AdminKroha/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Install/update dependencies before start (handles reboot after git pull)
ExecStartPre=/root/AdminKroha/venv/bin/pip install -r /root/AdminKroha/requirements.txt

ExecStart=/root/AdminKroha/venv/bin/python /root/AdminKroha/main.py

Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

LimitNOFILE=65536
LimitNPROC=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=admin-kroha

[Install]
WantedBy=multi-user.target